<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CoreSwap.Pages.NotificationsPage"
    Title="Alerts"
    BackgroundColor="#F6F9FE">

    <Grid Padding="16,18,16,8"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="14">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <VerticalStackLayout Spacing="4">

                <Label Text="Notifications"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#102C57"/>

                <Label x:Name="CountLabel"
                       Text="Your recent activity"
                       FontSize="12"
                       TextColor="#74849B"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
        Text="Refresh"
        FontSize="12"
        FontAttributes="Bold"
        TextColor="#176BFF"
        BackgroundColor="#EDF4FF"
        BorderColor="#DCE6F2"
        BorderWidth="1"
        CornerRadius="12"
        WidthRequest="85"
        HeightRequest="45"
        Clicked="OnRefreshClicked"/>
        </Grid>

        <Button Grid.Row="1"
                x:Name="MarkReadButton"
                Text="Mark All as Read"
                BackgroundColor="#EDF4FF"
                TextColor="#176BFF"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="44"
                Clicked="OnMarkReadClicked"/>

        <Grid Grid.Row="2">

            <CollectionView x:Name="NotificationsCollection"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,70"
                                         Spacing="10">

                        <Label Text="You're all caught up!"
                               FontSize="18"
                               TextColor="#102C57"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Service offers and messages will appear here."
                               TextColor="#74849B"
                               FontSize="12"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#DFE8F4"
                                StrokeShape="RoundRectangle 15"
                                Padding="14"
                                Margin="0,0,0,11">

                            <VerticalStackLayout Spacing="8">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Label Text="{Binding Title}"
                                           TextColor="#102C57"
                                           FontSize="15"
                                           FontAttributes="Bold"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           TextColor="#176BFF"
                                           FontSize="10"
                                           FontAttributes="Bold"/>
                                </Grid>

                                <Label Text="{Binding Message}"
                                       TextColor="#536A82"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="{Binding TimeText}"
                                       TextColor="#8999AF"
                                       FontSize="10"/>

                                <Button Text="Open"
                                        BackgroundColor="#EDF4FF"
                                        TextColor="#176BFF"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        FontSize="12"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnNotificationClicked"
                                        HorizontalOptions="End"
                                        Padding="22,0"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#176BFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
