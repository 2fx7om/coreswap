<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CoreSwap.Pages.AboutPage"
    Title="Profile"
    BackgroundColor="#F6F9FE">

    <ScrollView>
        <VerticalStackLayout
            Padding="18,18,18,35"
            Spacing="16">

            <!-- PROFILE HEADER -->
            <Border BackgroundColor="#102C57"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="22">

                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">

                    <Border BackgroundColor="#254A7B"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 35"
                            WidthRequest="70"
                            HeightRequest="70"
                            HorizontalOptions="Center">

                        <Label Text="&#x263A;"
                               TextColor="White"
                               FontSize="35"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <Label Text="My Profile"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="HeaderNameLabel"
                           Text="Student"
                           FontSize="15"
                           TextColor="#DCE8FF"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Manage your personal information"
                           FontSize="12"
                           TextColor="#B9D4FF"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- PERSONAL INFORMATION -->
            <Border BackgroundColor="White"
                    Stroke="#DFE8F4"
                    StrokeShape="RoundRectangle 18"
                    Padding="17">

                <VerticalStackLayout Spacing="13">

                    <Label Text="Personal Information"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#102C57"/>

                    <Label Text="Full Name"
                           FontAttributes="Bold"
                           TextColor="#102C57"
                           FontSize="13"/>

                    <Border BackgroundColor="#F8FAFE"
                            Stroke="#E2EAF5"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,2">

                        <Entry x:Name="FullNameEntry"
                               Placeholder="Enter your full name"
                               MaxLength="80"
                               TextColor="#102C57"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>

                    <Label Text="Phone Number"
                           FontAttributes="Bold"
                           TextColor="#102C57"
                           FontSize="13"/>

                    <Border BackgroundColor="#F8FAFE"
                            Stroke="#E2EAF5"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,2">

                        <Entry x:Name="PhoneEntry"
                               Placeholder="e.g. +60 12 345 6789"
                               Keyboard="Telephone"
                               MaxLength="25"
                               TextColor="#102C57"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>

                    <Label Text="Optional. Only you should be able to view this number."
                           FontSize="11"
                           TextColor="#74849B"/>

                    <Label Text="Email Address"
                           FontAttributes="Bold"
                           TextColor="#102C57"
                           FontSize="13"
                           Margin="0,3,0,0"/>

                    <Border BackgroundColor="#EEF2F8"
                            Stroke="#DFE5ED"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="9">

                            <Label x:Name="EmailLabel"
                                   Text="Loading..."
                                   TextColor="#68788D"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"/>

                            <Label Grid.Column="1"
                                   Text="Locked"
                                   TextColor="#8798AE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Label Text="Your email is linked to your account and cannot be changed here."
                           FontSize="11"
                           TextColor="#74849B"/>

                    <Button x:Name="SaveButton"
                            Text="Save Changes"
                            BackgroundColor="#176BFF"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="13"
                            HeightRequest="51"
                            Margin="0,8,0,0"
                            Clicked="OnSaveClicked"/>

                    <ActivityIndicator
                        x:Name="BusyIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#176BFF"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- ABOUT APPLICATION -->
            <Border BackgroundColor="White"
                    Stroke="#DFE8F4"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                <VerticalStackLayout Spacing="10">

                    <Label Text="About CoreSwap"
                           TextColor="#102C57"
                           FontAttributes="Bold"
                           FontSize="17"/>

                    <Label Text="A campus community application for technical help, hardware repairs, component swaps, tool loans and student services."
                           TextColor="#74849B"
                           FontSize="12"
                           LineBreakMode="WordWrap"/>

                    <BoxView HeightRequest="1"
                             Color="#E7EDF5"/>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10">

                        <Label Text="Developer"
                               TextColor="#74849B"
                               FontSize="12"/>

                        <Label Grid.Column="1"
                               Text="Albayati Omar Mustafa"
                               TextColor="#102C57"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="End"/>

                        <Label Grid.Row="1"
                               Text="Version"
                               TextColor="#74849B"
                               FontSize="12"/>

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="1.0"
                               TextColor="#102C57"
                               FontSize="12"
                               HorizontalTextAlignment="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- LOG OUT -->
            <Button Text="Log Out"
                    BackgroundColor="White"
                    BorderColor="#E4B8BD"
                    BorderWidth="1"
                    TextColor="#BF3B47"
                    FontAttributes="Bold"
                    CornerRadius="13"
                    HeightRequest="49"
                    Clicked="OnLogoutClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
